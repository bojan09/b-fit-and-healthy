{
  "name": "b-fit-and-healthy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build --webpack",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:contracts": "node --test tests/*.test.js",
    "test:unit": "vitest run",
    "test": "npm run test:contracts && npm run test:unit",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:e2e:smoke": "node --env-file-if-exists=.env.local ./node_modules/@playwright/test/cli.js test --grep @smoke --project=chromium-desktop",
    "test:e2e": "node --env-file-if-exists=.env.local ./node_modules/@playwright/test/cli.js test --project=chromium-desktop --project=chromium-tablet --project=chromium-mobile",
    "test:e2e:all": "node --env-file-if-exists=.env.local ./node_modules/@playwright/test/cli.js test",
    "verify:production": "npm run test && npm run typecheck && npm run lint && npm run build && npm run test:e2e:all"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.0",
    "@serwist/next": "9.5.11",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gray-matter": "4.0.3",
    "gsap": "3.15.0",
    "lucide-react": "1.25.0",
    "marked": "18.0.6",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sanitize-html": "2.17.7",
    "server-only": "0.0.1",
    "serwist": "9.5.11",
    "tailwind-merge": "3.6.0",
    "three": "0.185.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@types/three": "0.185.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "29.1.1",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
